---
layout: layout.liquid
pagination:
  size: 1
  addAllPagesToCollections: true
  alias: comic
noFooterImage: true
noNav: true
permalink: "stories/{{ comicTitle | slug }}/{% if comic.title %}{{ comic.title | slug }}{% else %}{{ pagination.pageNumber | plus: 1 }}{% endif %}/"
eleventyComputed:
  title: "{{ comicTitle }} - {% if comic.title %}{{ comic.title }}{% else %}page {{ pagination.pageNumber | plus: 1 }}{% endif %}"
  siteTheme: "{% if comic.theme %}{{ comic.theme }}{% elsif siteTheme %}{{ siteTheme }}{% endif %}"
---
{% assign index = pagination.pageNumber | plus: 1 %}
<link rel="stylesheet" href="/css/comic.css"/>
<link rel="stylesheet" href="/css/dialog.css"/>
{% if comic.bg %}
	<style>
		body {
			background-image: url({{ '/img/bg/' | append: comic.bg | append: '.png' | htmlBaseUrl }});
			background-attachment: fixed;
			background-position: center;
			background-size: cover;
		}
		main {
			box-shadow: none;
			background-color: #0000;
			margin: 0 auto;
		}
	</style>
{% endif %}
<div class="breadcrumbs"><a href="/stories/">Stories</a> {% lucide 'chevron-right' %} <a href="../">{{ comicTitle }}</a> {% lucide 'chevron-right' %} <a href="{{ page.url }}">{% if comic.title %}{{ comic.title }}{% else %}Page {{ index }}{% endif %}</a></div>
{% include 'arrows', f: pagination.href.first, p: pagination.href.previous, n: pagination.href.next, l: pagination.href.last, num: index, top: true %}
{% if comic.title %}<h2>{{ comic.title }}</h2>{% endif %}
{% for part in comic.content %}
	{% if part.first %}
		{% comment %} is array, is dialog {% endcomment %}
		{% include 'dialog', dialogContent: part %}
	{% else %}
		{% assign path = 'comics/' | append: part | append: '.png' %}
		{% if comic.title %}{% assign alt = comic.title %}{% else %}{% assign alt = "Page " | append: index %}{% endif %}
		{% image path 1000 alt 'img' %}
	{% endif %}
{% endfor %}
{% include 'arrows', f: pagination.href.first, p: pagination.href.previous, n: pagination.href.next, l: pagination.href.last, num: index %}
<div id="date-save">
	<p>{{ comic.date }}</p>
	<div id="save">
		<button title="Save" onclick="save()">{% lucide 'arrow-down-from-line' %}</button>
		<button title="Load" onclick="load()">{% lucide 'arrow-up-from-line' %}</button>
		{% if archive %}<a title="Archive" href="../archive/">{% lucide 'list' %}</a>{% endif %}
	</div>
</div>
{% if comic.note %}
	<div id="note" class="graybox">{{ comic.note | renderMD }}</div>
{% endif %}
<script>
	// save
	function save() {
		localStorage.setItem('{{ comicTitle }} place', {{ pagination.pageNumber }});
		alert(`Page {{ pagination.pageNumber }} saved!`);
	}
	function load() {
		let place = localStorage.getItem('{{ comicTitle }} place');
		if(place !== undefined) window.open(`../${place}/#arrow`, '_self');
		else alert('no place was saved!');
	}
</script>