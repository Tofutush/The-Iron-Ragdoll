---
layout: article.liquid
tags:
  - storieszh
---
<dl>
	<dt>角色</dt>
	<dd class="tags">
		{% for ch in chs %}
			{% assign char = characters | getChByName: ch %}
			<a class="character-button" style="--c: {{ char.color }}; color: {{ characters | getChColor: char.name | to6DigitHex | calculateBlackWhite }}" href="{% zhLink char.namezh %}">{{ char.namezh }}</a>
		{% endfor %}
	</dd>
	<dt>时间</dt>
	<dd>{{ time }}</dd>
</dl>

{{ content }}
