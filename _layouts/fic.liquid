---
layout: layout.liquid
eleventyComputed:
  title: "{{ parent }}{% if chNum %} Chapter {{ chNum }}{% endif %}{% if chTitle %}: {{ chTitle }}{% endif %}"
  navTitle: "{% if chNum %}Chapter {{ chNum }}{% endif %}{% if chTitle and chNum %}: {% endif %}{% if chTitle %}{{ chTitle }}{% endif %}"
---
{% assign colName = parent | append: "-fic" %}
<h1>{% if chTitle %}{{ chTitle }}{% else %}Chapter {{ chNum }}{% endif %}</h1>
{{ content }}
{% assign prev = collections[colName] | getPreviousCollectionItem %}
{% assign next = collections[colName] | getNextCollectionItem %}
{% if prev or next %}
	<hr class="solid-hr"/>
	{% include 'prevnext' prev: prev.url, next: next.url %}
{% endif %}
<details class="toc callout">
	<summary class="callout-title">
		<div class="callout-title-icon">{% lucide 'list' 24 %}</div>
		<div class="callout-title-inner">Chapters</div>
	</summary>
	<div class="callout-content">
		<ol>
			{% for ch in collections[colName] %}
				<li><a href="{{ ch.url }}">{% if ch.data.chTitle %}{{ ch.data.chTitle }}{% else %}Chapter {{ ch.data.chNum }}{% endif %}</a></li>
			{% endfor %}
		</ol>
	</div>
</details>
