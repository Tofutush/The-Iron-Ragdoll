---
layout: layout.liquid
desc: Archive
permalink: "stories/{{ comicTitle | slug }}/archive/"
eleventyComputed:
  title: "{{ comicTitle }} - archive"
  navTitle: Archive
  parent: "{{ comicTitle }}"
  eleventyNavigation:
    order: 0
---
<style>
	.archive {
		display: grid;
		gap: 1em;
		grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
		& img {
			object-fit: cover;
			width: 100%;
			height: auto;
			aspect-ratio: 1;
		}
	}
</style>
<h1>{{ comicTitle }} Archive</h1>
{% if multiChapter %}
	{% comment %} still needs redoing! {% endcomment %}
	{% assign grouped = comicData[dataName] | groupByChapter %}
	{% for group in grouped %}
		{% if group.pages[0].title %}
			<h2>{{ group.pages[0].title }}</h2>
		{% else %}
			<h2>Chapter {{ group.chapter }}</h2>
		{% endif %}
		<section class="archive">
			{% for page in group.pages %}
			<a href="../{{ page.pagenum }}/">
				{% if page.url.first %}
					{% assign p = page.url[0] %}
				{% else %}
					{% assign p = page.url %}
				{% endif %}
				{% assign path = "comics/" | append: p | append: '.png' %}
				{% if page.alt %}
					{% assign alt = page.alt %}
				{% else %}
					{% assign alt = "Page " | append: page.pagenum %}
				{% endif %}
				{% imageThumb path 200 alt %}
			</a>
			{% endfor %}
		</section>
	{% endfor %}
{% else %}
	<section class="archive">
		{% for page in comicData[dataName] %}
			<a href="../{% if page.title %}{{ page.title | slug }}{% else %}{{ forloop.index }}{% endif %}/">
				{% for part in page.content %}
					{% if part.first == undefined %}
						{% assign path = "comics/" | append: part | append: '.png' %}
						{% if comic.title %}{% assign alt = comic.title %}{% else %}{% assign alt = "Page " | append: forloop.index %}{% endif %}
						{% imageThumb path 200 alt %}
						{% break %}
					{% endif %}
				{% endfor %}
			</a>
		{% endfor %}
	</section>
{% endif %}