---
title: Keyboard
desc: Type Bauhinian!
parent: Language
categories:
  - Language
---

<style>
	#output {
		width: 100%;
		height: 8em;
		font-family: var(--font);
		font-size: var(--font-size);
	}

	#wrapper {
		width: 100%;
		overflow-x: auto;
	}

	#keyboard {
		width: fit-content;
	}

	.row {
		display: flex;
		justify-content: center;
		gap: .5em;
		margin: .5em;

		.key {
			width: 2em;
			height: 2em;
			background-color: var(--box);
			padding: .3em;
			display: flex;
			justify-content: space-between;
			border-radius: 6px;
			user-select: none;
			cursor: pointer;
			transition: transform .2s var(--bezier);

			&:hover{
				transform: translateY(-.2em);
			}

			&:active{
				transform: translateY(0);
			}

			.en {
				align-self: end;
				color: var(--c);
				font-size: var(--font-size-small);
			}

			.bh {
				font-weight: 500;
				font-size: var(--font-size-h3);
				line-height: 0.5;
			}
		}
	}

	#row2 {
		padding-left: 2em;
	}

	#shift {
		width: 4em;
		justify-content: center;
		align-items: center;

		&.pressed {
			outline: 2px solid var(--c);
		}
	}

	#space {
		width: 20em;
	}
</style>
<p>Here you can type in Bauhinian without hassle! Mostly for myself LMAO.</p>
<textarea id="output" dir="rtl"></textarea>
<div id="wrapper">
	<div id="keyboard">
		<div class="row" id="row1"></div>
		<div class="row" id="row2"></div>
		<div class="row" id="row3">
			<div class="key" id="shift">Shift</div>
		</div>
		<div class="row" id="row4">
			<div class="key" id="space"></div>
		</div>
	</div>
</div>
<script>
	const keys = [
		[ // row 1
			{ en: "Q", bh: "ق", shift: "ـ" },
			{ en: "W", bh: "ۋ" },
			{ en: "E", bh: "ە" },
			{ en: "R", bh: "ر" },
			{ en: "T", bh: "ت", shift: "ث" },
			{ en: "Y", bh: "ي" },
			{ en: "U", bh: "ۇ" },
			{ en: "I", bh: "ى", shift: "ې" },
			{ en: "O", bh: "و" },
			{ en: "P", bh: "پ" },
			{ en: "[", shift: "»" },
			{ en: "]", shift: "«" }
		],
		[ // row 2
			{ en: "A", bh: "ا" },
			{ en: "S", bh: "س", shift: "ش" },
			{ en: "D", bh: "د", shift: "ذ" },
			{ en: "F", bh: "ف" },
			{ en: "G", bh: "گ" },
			{ en: "H", bh: "ھ" },
			{ en: "J", bh: "ژ" },
			{ en: "K", bh: "ك" },
			{ en: "L", bh: "ل", shift: "لا" },
			{ en: ";", bh: "؛" }
		],
		[ // row 3
			{ en: "Z", bh: "ز", shift: "ج" },
			{ en: "X", bh: "خ" },
			{ en: "C", bh: "څ", shift: "چ" },
			{ en: "V", bh: "ڤ" },
			{ en: "B", bh: "ب" },
			{ en: "N", bh: "ن" },
			{ en: "M", bh: "م" },
			{ en: ",", bh: "،" },
			{ en: ".", bh: "" },
			{ en: "/", bh: "ئ", shift: "؟" }
		]
	];
	const textareaDiv = document.getElementById('output');

	let shiftOn = false;
	// init
	buildKeyboard();
	document.addEventListener('click', e => {
		// find key div
		let keyDiv = e.target.closest('.key');
		if (!keyDiv) return;
		if (keyDiv.id == 'shift') {
			toggleShift();
			return;
		}
		if (keyDiv.id == 'space') {
			addText(' ');
			return;
		}
		if (shiftOn) {
			addText(keyDiv.data.shift || keyDiv.data.bh || keyDiv.data.en);
			toggleShift(false);
		}
		else addText(keyDiv.data.bh || keyDiv.data.en);
	});

	document.addEventListener('keydown', e => {
		// dont interfere w/ these
		if (e.ctrlKey || e.altKey || e.metaKey) return;
		// toggle shift
		if (e.shiftKey) toggleShift(true);
		// find key
		let key;
		if (e.code == 'Slash') key = keys[2][9];
		else if (e.code == 'BracketLeft') key = keys[0][11];
		else if (e.code == 'BracketRight') key = keys[0][10];
		else {
			let pressedKey = e.key.toUpperCase();
			key = keys.flat().find(k => k.en == pressedKey);
			if (!key) return;
		}
		e.preventDefault();
		if (e.shiftKey) addText(key.shift || key.bh || key.en);
		else addText(key.bh || key.en);
	});

	document.addEventListener('keyup', e => {
		if (e.key == 'Shift') toggleShift(false);
	});

	function buildKeyboard() {
		for (let row in keys) {
			let rowDiv = document.getElementById('row' + (parseInt(row) + 1));
			rowDiv.innerHTML = '';
			// if row 3, add shift key
			if (row == 2) rowDiv.appendChild(elt('div', { className: `key ${shiftOn ? 'pressed' : ''}`, id: 'shift' }, "Shift"));
			for (let key of keys[row]) {
				let en = elt('span', { className: 'en' }, key.en);
				let keyDiv = elt('div', { className: 'key', data: key }, en);
				let bh;
				// the weird classname is for layout consistency: instead of not adding the letters, hide them
				if (shiftOn) bh = elt('span', { className: 'bh' }, key.shift || '');
				else bh = elt('span', { className: 'bh' }, key.bh || '');
				keyDiv.appendChild(bh);
				rowDiv.appendChild(keyDiv);
			}
		}
	}

	function addText(text) {
		textareaDiv.setRangeText(text, textareaDiv.selectionStart, textareaDiv.selectionEnd, "end");
	}

	function toggleShift(on) {
		if (on) shiftOn = true;
		else if (on == false) shiftOn = false;
		else shiftOn = !shiftOn;
		buildKeyboard();
	}

	function elt(type, props, ...children) {
		let dom = document.createElement(type);
		if (props) Object.assign(dom, props);
		for (let child of children) {
			if (typeof child == "string") dom.appendChild(document.createTextNode(child));
			else dom.appendChild(child);
		}
		return dom;
	}
</script>