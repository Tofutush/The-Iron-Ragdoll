---
title: Dictionary
desc: A list of words in Bauhinian.
parent: Language
draft: true
categories:
  - Language
toc: true
topTocOnly: true
---
<style>
	h2 {
		text-align: center;
	}
	.box-nav a {
		line-height: 1.5;
	}
</style>
<p>Words listed: {{ groupedDict[0] }}</p>
{% for letter in groupedDict %}
	{% unless forloop.first %}
		<h2 id="{{ letter[0] | slug }}">{{ letter[0] }}</h2>
		<div class="table-responsive">
			<table>
				<thead>
					<tr>
						<th>Type</th>
						<th>Definition</th>
						<th dir="rtl">سەث</th>
					</tr>
				</thead>
				<tbody>
					{% for word in letter[1] %}
						<tr>
							<td>{{ word.pos }}</td>
							<td>{{ word.def }}</td>
							<td dir="rtl">{{ word.bh }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	{% endunless %}
{% endfor %}
