---
layout: article.liquid
pagination:
  data: collections.worldCats
  size: 1
  alias: tagName
  addAllPagesToCollections: true
permalink: "world/category/{{ tagName | slug }}/"
parent: Categories
pagefindIgnore: true
eleventyComputed:
  key: "cat-{{ tagName }}"
  title: "{{ tagName }}"
---
{% assign filteredFiles = collections.world | filterWorldByTag: tagName %}
<ul>
    {% assign sortedFiles = filteredFiles | sort: "url" %}
    {% for file in sortedFiles %}
        {% include 'fileLi', file: file %}
    {% endfor %}
</ul>
