---
layout: article.liquid
title: Character List
navTitle: List
widepage: true
desc: A sortable text list of characters.
parent: Characters
pagefindIgnore: true
eleventyNavigation:
  order: 0
---
<style>
	.color {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	td a {
		width: 100%;
		height: 100%;
		display: inline-block;
	}
</style>
<div class="table-responsive">
	<table>
		<thead>
			<tr>
				<th>No.</th>
				<th>Name</th>
				<th>中文</th>
				<th dir="rtl">سەث</th>
				<th>Image count</th>
				<th>Last drawn</th>
				<th>Birthday</th>
				<th>Color</th>
			</tr>
		</thead>
		<tbody>
			{% for ch in characters %}
				<tr>
					<td>{{ forloop.index }}</td>
					<td><a href="/characters/{{ ch.name | lowerCase }}/">{{ ch.name }}</a></td>
					<td>{{ ch.namezh }}</td>
					<td dir="rtl">{{ ch.namebh }}</td>
					{% assign filteredGallery = gallery | filterGallery: ch.name %}
					<td><a href="/characters/{{ ch.name | lowerCase }}/{% if filteredGallery.size > 10 %}gallery/{% else %}#gallery{% endif %}">{{ filteredGallery.size }}</a></td>
					{% assign lastDrawn = filteredGallery | getOnlyMyArt %}
					<td>{{ lastDrawn[0].date }}</td>
					<td>{{ ch.attr.Birth }}</td>
					<td class="color" style="background-color: {{ ch.color }}; color: {{ ch.color | calculateBlackWhite }}">{{ ch.color | to6DigitHex | upperCase }}</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>
</div>
<script src="/js/sort.js"></script>
<script>
	const order = [
		"ئا",
		"ئە",
		"ئې",
		"ئى",
		"ئو",
		"ئۇ",
		"ب",
		"پ",
		"د",
		"ت",
		"ك",
		"گ",
		"ف",
		"ڤ",
		"ھ",
		"م",
		"ن",
		"ي",
		"ۋ",
		"ل",
		"ز",
		"څ",
		"س",
		"ج",
		"چ",
		"ش",
		"ر",
		"ژ",
		"ق",
		"خ",
		"ث",
		"ذ"
	];
	function getFirst(word) {
		let letter = stripWord(word)[0];
		if ("اەېىوۇ".includes(letter)) letter = 'ئ' + letter;
		return letter;
	}
	function stripWord(word) {
		return word.replaceAll('-', '').replaceAll('ئ', '');
	}
	function firstKey(stripped) {
		let letter = stripped[0];
		if ("اەېىوۇ".includes(letter)) letter = 'ئ' + letter;
		return letter;
	}
	function sortBh(a, b) {
		if (a == '') return 1;
		if (b == '') return -1;
		const aStripped = stripWord(a);
		const bStripped = stripWord(b);
		const aFirst = firstKey(aStripped);
		const bFirst = firstKey(bStripped);
		if (aFirst == a) return 1;
		if (bFirst == b) return -1;
		const len = Math.min(aStripped.length, bStripped.length);
		for (let i = 0; i < len; i++) {
			const comp = order.indexOf(firstKey(aStripped.slice(i))) - order.indexOf(firstKey(bStripped.slice(i)));
			if (comp != 0) return comp;
		}
		return 1;
	}
	let sort = new SortTable(document.querySelector('table'));
	sort.addSort({
		colName: 'No.',
		keyFunc: td => parseInt(td.innerText),
		sortFunc: SortTable.sortFuncNumber
	});
	sort.addSort({
		colName: 'Name',
		keyFunc: td => td.querySelector('a').innerText,
		sortFunc: SortTable.sortFuncString
	});
	sort.addSort({
		colName: '中文',
		keyFunc: td => td.innerText,
		sortFunc: SortTable.sortFuncZh
	});
	sort.addSort({
		colName: 'سەث',
		keyFunc: td => td.innerText,
		sortFunc: sortBh
	});
	sort.addSort({
		colName: 'Image count',
		keyFunc: td => parseInt(td.innerText),
		sortFunc: SortTable.sortFuncNumber
	});
	sort.addSort({
		colName: 'Birthday',
		keyFunc: td => td.innerText,
		sortFunc: SortTable.sortFuncString
	});
	sort.addSort({
		colName: 'Last drawn',
		keyFunc: td => td.innerText,
		sortFunc: SortTable.sortFuncString
	});
	sort.addSort({
		colName: 'Color',
		keyFunc: td => SortTable.RGBToHSL(td.style.backgroundColor),
		sortFunc: SortTable.sortFuncHSL
	});
</script>